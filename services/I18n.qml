        var table = root.locale === "zh_TW" ? root.zhTW
            : (root.locale === "zh_CN" ? root.zhCN : (root.locale === "ja" ? root.ja : root.en));
        var value = table[key];
        if (value === undefined)
            value = root.en[key];
        return value === undefined ? key : value;
    }

    function has(key) {
        return root.en[key] !== undefined;
