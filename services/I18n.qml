// I18n.qml — 四語言（繁體中文 / 简体中文 / English / 日本語）。
// 戰術標籤（SECTOR、DEPLOY、HUD 等）保留英文以貼近原作；
// 說明性文字、設定頁、側邊欄、彈出欄與媒體歌詞走這裡。
QtObject {
    id: root

    function normalize(value) {
        var v = ("" + (value === undefined || value === null ? "" : value)).toLowerCase().replace(/-/g, "_");
        if (v === "" || v === "auto") {
            var env = (Quickshell.env("LC_ALL") || Quickshell.env("LC_MESSAGES") || Quickshell.env("LANG") || "").toLowerCase();
            v = env;
        }
        if (v.indexOf("zh") === 0)
            return (v.indexOf("cn") >= 0 || v.indexOf("hans") >= 0 || v.indexOf("sg") >= 0) ? "zh_CN" : "zh_TW";
        if (v.indexOf("ja") === 0)
            return "ja";
        if (v.indexOf("en") === 0)
            return "en";
        return "en";
    }

    readonly property string locale: root.normalize(Settings.get("language", "auto"))
    readonly property bool zh: root.locale === "zh_TW" || root.locale === "zh_CN"
    readonly property string nativeName: root.locale === "zh_TW" ? "繁體中文"
